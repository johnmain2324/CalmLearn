rules_version = '2';

// Dan vao Firebase Console > Firestore Database > Rules, roi bam Publish.
// Chi chinh chu tai lieu (request.auth.uid == userId) moi duoc doc/ghi ho so cua minh -
// khong mo quyen doc/ghi toan bo collection "users" cho bat ky ai da dang nhap.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
