<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/optionRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card_stroke"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/optionLetter"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_icon_circle_teal_light"
        android:gravity="center"
        android:text="A"
        android:textColor="@color/teal_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/optionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:text="Option text"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/optionResultIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_check"
        android:tint="@color/success"
        android:visibility="gone"
        android:contentDescription="@null" />

</LinearLayout>
